# =============================================================================
# adaptive_scientific_discovery — central path / environment configuration
#
# Sourced (bash) by run_procedure_rsi.sh, batch_procedure_rsi.sh,
# run_paired_ablation.sh, run_nd_sweep.sh and batch_nd_sweep.sh, and by
# `python run_procedure_rsi.py --env_file .env`.  It holds:
#   1. machine-specific paths (venv, scratch caches, Hugging Face caches, logs)
#   2. the PREDEFINED experiment variables (model, decoding, Procedure-RSI knobs)
#
# configs/*.conf files are sourced AFTER this file and override whatever they
# set (model name, N, budget, ablation switches ...).  CLI flags override both.
#
# Convention: a variable with two candidate values keeps the ACTIVE value
# uncommented and the ALTERNATIVE commented out just below it — flip the
# comment to switch. Every value uses ${VAR:-...} so an explicit override
# still wins, e.g. `RSI_N_SLOTS=8 bash run_procedure_rsi.sh develop ...`.
# =============================================================================

# --- Repository root (directory containing this file) -------------------------
_ENV_FILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REPO_DIR="${REPO_DIR:-$_ENV_FILE_DIR}"

# --- Scratch root -------------------------------------------------------------
# Every scratch path below is derived from $SCRATCH so only ONE line changes when
# moving to a different cluster. OSCER/HPRC already export SCRATCH in the login
# profile (e.g. /scratch/user/$USER); the fallbacks below cover the case where it
# is unset (batch jobs with a clean env, other machines). Layouts seen so far:
#   /scratch/user/$USER   (current cluster)      /scratch/$USER   (flat layout)
if [[ -z "${SCRATCH:-}" ]]; then
    if [[ -d "/scratch/user/$USER" ]]; then
        export SCRATCH="/scratch/user/$USER"
    else
        export SCRATCH="/scratch/$USER"
    fi
fi

# --- Virtual environment (uv) activation root ---------------------------------
# Active: `crisp` venv built from pyproject.toml + uv.lock (Python 3.12, torch
# 2.10+cu128, transformers 4.57.6) with
#   UV_PROJECT_ENVIRONMENT=$SCRATCH/uv_envs/crisp uv sync --frozen --no-install-package vllm
# (vllm 0.19.1's wheel needs glibc>=2.31; these RHEL8 nodes ship glibc 2.28).
# Alternative (commented): the older train_free_kv venv — Python 3.11, torch 2.1.2,
# transformers 4.44 — too old for this code (model_wrapper passes `dtype=`,
# scikit-learn / sentence-transformers are missing).
export VENV_PATH="${VENV_PATH:-$SCRATCH/uv_envs/crisp}"
# export VENV_PATH="${VENV_PATH:-$SCRATCH/uv_envs/train_free_kv}"

# --- Log / output directories ---------------------------------------------------
# (#SBATCH --output/--error dirs are set separately in the batch scripts)
export LOG_DIR="${LOG_DIR:-$REPO_DIR/logs}"
# Results are saved CONTINUOUSLY here (checkpoints + phase outputs); re-running the
# same command with the same RSI_RUN_NAME resumes from where it stopped.
export RSI_OUTPUT_ROOT="${RSI_OUTPUT_ROOT:-$SCRATCH/procedure_rsi_results}"
# export RSI_OUTPUT_ROOT="${RSI_OUTPUT_ROOT:-$REPO_DIR/experiments_results/procedure_rsi}"
export RSI_CHECKPOINT_EVERY_S="${RSI_CHECKPOINT_EVERY_S:-60}"

# --- Scratch cache / tmp dirs (never write under $HOME) -----------------------
export TMPDIR="${TMPDIR:-$SCRATCH/tmp}"
export PIP_CACHE_DIR="${PIP_CACHE_DIR:-$SCRATCH/pip_cache}"
# uv: wheel cache (tens of GB), managed Python installs, and the project venv it
# syncs into. UV_PROJECT_ENVIRONMENT keeps `uv sync` / `uv run` on VENV_PATH.
export UV_CACHE_DIR="${UV_CACHE_DIR:-$SCRATCH/uv_cache}"
export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-$SCRATCH/uv_python}"
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$VENV_PATH}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$SCRATCH/.cache}"
export TORCH_EXTENSIONS_DIR="${TORCH_EXTENSIONS_DIR:-$SCRATCH/torch_extensions}"
export CUDA_CACHE_PATH="${CUDA_CACHE_PATH:-$SCRATCH/.nv/ComputeCache}"

# --- Hugging Face caches ------------------------------------------------------
export HF_HOME="${HF_HOME:-$SCRATCH/hf_cache}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME}"
export HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
# Set to 1 on compute nodes without internet once models/datasets are cached.
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-0}"
export HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-$HF_HUB_OFFLINE}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"

# =============================================================================
# PREDEFINED EXPERIMENT VARIABLES
# (configs/*.conf override these per model / per experiment)
# =============================================================================

# --- Model ----------------------------------------------------------------------
export MODEL_NAME="${MODEL_NAME:-Qwen/Qwen2.5-1.5B-Instruct}"
export BATCH_SIZE="${BATCH_SIZE:-32}"
export SEED="${SEED:-1234}"

# --- Original paired-ablation pipeline (run_paired_ablation.sh / run_nd_sweep.sh) ---
export VERIFIER_MODEL="${VERIFIER_MODEL:-Qwen/Qwen2.5-Math-PRM-7B}"
export EMBEDDING_MODEL="${EMBEDDING_MODEL:-all-MiniLM-L6-v2}"
export MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-2048}"
export TEMPERATURE="${TEMPERATURE:-0.7}"
export TOP_P="${TOP_P:-0.95}"
export CIMR_N_ROLLOUTS="${CIMR_N_ROLLOUTS:-8}"
export CIMR_DEPTH="${CIMR_DEPTH:-4}"

# --- Procedure RSI: backend ----------------------------------------------------------
export RSI_BACKEND="${RSI_BACKEND:-hf}"                     # hf | vllm (vllm needs glibc>=2.31)
# export RSI_BACKEND="${RSI_BACKEND:-vllm}"
export RSI_DTYPE="${RSI_DTYPE:-bfloat16}"
export RSI_MAX_INPUT_TOKENS="${RSI_MAX_INPUT_TOKENS:-4096}"

# --- Procedure RSI: role decoding (same frozen model in every role) -------------------
export RSI_INIT_MAX_NEW_TOKENS="${RSI_INIT_MAX_NEW_TOKENS:-2048}"
export RSI_INIT_TEMPERATURE="${RSI_INIT_TEMPERATURE:-0.7}"
export RSI_TOP_P="${RSI_TOP_P:-0.95}"
export RSI_REWRITE_MAX_NEW_TOKENS="${RSI_REWRITE_MAX_NEW_TOKENS:-2048}"
export RSI_REWRITE_TEMPERATURE="${RSI_REWRITE_TEMPERATURE:-0.7}"      # 0 → greedy (old CIMR code path)
export RSI_CRITIQUE_MAX_NEW_TOKENS="${RSI_CRITIQUE_MAX_NEW_TOKENS:-384}"
export RSI_CRITIQUE_TEMPERATURE="${RSI_CRITIQUE_TEMPERATURE:-0.0}"
export RSI_CORRECT_MAX_NEW_TOKENS="${RSI_CORRECT_MAX_NEW_TOKENS:-1024}"
export RSI_CORRECT_TEMPERATURE="${RSI_CORRECT_TEMPERATURE:-0.0}"

# --- Procedure RSI: inner loop (§4) — pilot settings from §9 -------------------------
export RSI_N_SLOTS="${RSI_N_SLOTS:-4}"                      # N (paper: 8)
export RSI_H0_DEPTH="${RSI_H0_DEPTH:-2}"                    # H0 round-robin depth
export RSI_BUDGET_MODE="${RSI_BUDGET_MODE:-h0_cycles}"      # h0_cycles | absolute
export RSI_BUDGET_CYCLES="${RSI_BUDGET_CYCLES:-2}"          # ≈ two full refinement cycles per slot
export RSI_COST_MEASURE="${RSI_COST_MEASURE:-tflops}"       # predeclared: tflops | tokens | calls
export RSI_DISABLED_ACTIONS="${RSI_DISABLED_ACTIONS:-}"     # e.g. KEEP or RESTART (ablations)

# --- Procedure RSI: counterfactual measurement (§5) -----------------------------------
export RSI_UTILITY_LAMBDA="${RSI_UTILITY_LAMBDA:-0.2}"
export RSI_CF_SEEDS="${RSI_CF_SEEDS:-4}"                    # K continuation seeds per tested action
export RSI_CF_STATES_PER_PROBLEM="${RSI_CF_STATES_PER_PROBLEM:-1}"
export RSI_CF_ALT_SLOTS="${RSI_CF_ALT_SLOTS:-2}"
export RSI_CF_PAIRS_PER_STATE="${RSI_CF_PAIRS_PER_STATE:-2}"
export RSI_CF_EXPLORE_FRAC="${RSI_CF_EXPLORE_FRAC:-0.3}"

# --- Procedure RSI: outer loop (§6) ---------------------------------------------------
export RSI_ROUNDS="${RSI_ROUNDS:-5}"
export RSI_SEARCH_BATCH_SIZE="${RSI_SEARCH_BATCH_SIZE:-20}"
export RSI_CONFIRM_BLOCK_SIZE="${RSI_CONFIRM_BLOCK_SIZE:-40}"
export RSI_CONFIRM_SEEDS="${RSI_CONFIRM_SEEDS:-2}"
export RSI_EDITOR_MODE="${RSI_EDITOR_MODE:-both}"           # llm | compiler | both
export RSI_EDITOR_NUM_PROPOSALS="${RSI_EDITOR_NUM_PROPOSALS:-4}"
export RSI_ALPHA_TOTAL="${RSI_ALPHA_TOTAL:-0.05}"           # α_t = α / R
export RSI_NONINFERIORITY_MARGIN="${RSI_NONINFERIORITY_MARGIN:-0.02}"

# --- Procedure RSI: data (§6) ---------------------------------------------------------
export RSI_DEV_DATASETS="${RSI_DEV_DATASETS:-math_train}"    # search + confirmation pool
export RSI_TEST_DATASETS="${RSI_TEST_DATASETS:-math500}"     # sealed / benchmark evaluation
export RSI_DEV_POOL_MAX="${RSI_DEV_POOL_MAX:-2000}"

# Copy to .env and edit the paths.  run_arr.sh sources .env, then the conf files.
_ENV_FILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REPO_DIR="${REPO_DIR:-$_ENV_FILE_DIR}"
export SCRATCH="${SCRATCH:-$REPO_DIR/.work}"          # large files: caches, results, temporary files

export VENV_PATH="${VENV_PATH:-$REPO_DIR/.venv}"
export TF5_VENV_PATH="${TF5_VENV_PATH:-$SCRATCH/venvs/arr_tf5}"   # transformers >= 5 (Gemma-4, Qwen3.5)
export ARR_CONFS="${ARR_CONFS:-configs/arr_qwen_math_7b.conf,configs/arr_aime24.conf}"
export PYTHONNOUSERSITE=1

export LOG_DIR="${LOG_DIR:-$REPO_DIR/logs}"
export ARR_OUTPUT_ROOT="${ARR_OUTPUT_ROOT:-$SCRATCH/arr_results}"
export ARR_LOG_EVERY_S="${ARR_LOG_EVERY_S:-60}"

export TMPDIR="${TMPDIR:-$SCRATCH/tmp}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-$SCRATCH/uv_cache}"
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$VENV_PATH}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"

export HF_HOME="${HF_HOME:-$SCRATCH/hf_cache}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME}"
export HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-0}"
export HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-$HF_HUB_OFFLINE}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"

export MODEL_NAME="${MODEL_NAME:-Qwen/Qwen2.5-Math-7B-Instruct}"
export SEED="${SEED:-1234}"

# Shared decoding and output caps (identical for every method).
export ARR_DTYPE="${ARR_DTYPE:-bfloat16}"
export ARR_THINKING="${ARR_THINKING:-off}"
export ARR_MAX_INPUT_TOKENS="${ARR_MAX_INPUT_TOKENS:-2560}"
export ARR_MAX_NEW_TOKENS="${ARR_MAX_NEW_TOKENS:-1536}"
export ARR_CRITIQUE_MAX_NEW_TOKENS="${ARR_CRITIQUE_MAX_NEW_TOKENS:-384}"
export ARR_GPU_MEMORY_UTILIZATION="${ARR_GPU_MEMORY_UTILIZATION:-0.92}"
export ARR_ENGINE_WORKSPACE_GB="${ARR_ENGINE_WORKSPACE_GB:-5}"
export ARR_ENGINE_MAX_ROWS="${ARR_ENGINE_MAX_ROWS:-0}"
export ARR_TEMPERATURE="${ARR_TEMPERATURE:-0.7}"
export ARR_TOP_P="${ARR_TOP_P:-0.95}"

# ARR: width N, budgets B (TFLOPs per question), block size W, revision prompt.
export ARR_N_ACTIVE="${ARR_N_ACTIVE:-4}"
export ARR_BUDGETS="${ARR_BUDGETS:-200,400,800}"
export ARR_COST_MEASURE="${ARR_COST_MEASURE:-tflops}"
export ARR_BLOCK_SIZE="${ARR_BLOCK_SIZE:-32}"
export ARR_REVISE_PROMPT="${ARR_REVISE_PROMPT:-0}"

# Baselines: depth D of Self-Refine, prompt-lookup decoding of ARR_PLD.
export ARR_FIXED_DEPTH="${ARR_FIXED_DEPTH:-4}"
export ARR_PLD_MAX_NGRAM="${ARR_PLD_MAX_NGRAM:-3}"
export ARR_PLD_NUM_PRED="${ARR_PLD_NUM_PRED:-10}"

export ARR_METHODS="${ARR_METHODS:-arr,replace_ordinary,replace_pld,arr_no_replace,direct_fixed,critic_correct,continuation,maj}"
export ARR_DATASETS="${ARR_DATASETS:-aime24}"
export ARR_SEEDS="${ARR_SEEDS:-1}"
export ARR_PILOT_DATASET="${ARR_PILOT_DATASET:-math500}"
export ARR_PILOT_SAMPLES="${ARR_PILOT_SAMPLES:-50}"
